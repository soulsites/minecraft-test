{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "myaddon:frost_golem",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/frost_golem" },
      "geometry": { "default": "geometry.frost_golem" },
      "render_controllers": ["controller.render.frost_golem"],
      "animations": {
        "walk": "animation.frost_golem.walk",
        "look_at_target": "animation.frost_golem.look_at_target",
        "attack": "animation.frost_golem.attack"
      },
      "scripts": {
        "animate": [
          { "walk": "query.modified_move_speed > 0.05" },
          "look_at_target",
          { "attack": "query.property('myaddon:attacking')" }
        ]
      },
      "spawn_egg": { "texture": "spawn_egg_frost_golem" }
    }
  }
}
