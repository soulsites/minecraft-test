{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "myaddon:sonic_bow",
      "materials": { "default": "entity_alphatest" },
      "textures": {
        "default": "textures/items/sonic_bow",
        "bow_pulling_0": "textures/items/sonic_bow_pulling_0",
        "bow_pulling_1": "textures/items/sonic_bow_pulling_1",
        "bow_pulling_2": "textures/items/sonic_bow_pulling_2",
        "arrow_nock": "textures/items/sonic_bow_arrow_nock"
      },
      "geometry": {
        "default": "geometry.sonic_bow_standby",
        "bow_pulling_0": "geometry.sonic_bow_pulling_0",
        "bow_pulling_1": "geometry.sonic_bow_pulling_1",
        "bow_pulling_2": "geometry.sonic_bow_pulling_2"
      },
      "animations": {
        "wield": "animation.sonic_bow.wield",
        "wield_first_person_pull": "animation.sonic_bow.wield_first_person_pull"
      },
      "scripts": {
        "pre_animation": [
          "variable.charge_amount = math.clamp((query.main_hand_item_max_duration - query.main_hand_item_use_duration) / math.max(query.main_hand_item_max_duration, 0.01), 0.0, 1.0);"
        ],
        "animate": [
          "wield",
          { "wield_first_person_pull": "query.main_hand_item_use_duration > 0.0f && c.is_first_person" }
        ]
      },
      "render_controllers": ["controller.render.sonic_bow"]
    }
  }
}
