{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.sonic_bow": {
      "arrays": {
        "textures": {
          "Array.pulling": ["Texture.pulling_0", "Texture.pulling_1", "Texture.pulling_2"]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": [
        "!query.is_using_item ? Texture.default : Array.pulling[math.min(2, math.floor(query.use_duration * 3 / math.max(query.max_use_duration, 0.05)))]"
      ]
    }
  }
}
