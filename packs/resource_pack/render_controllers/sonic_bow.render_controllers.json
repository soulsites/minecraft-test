{
  "format_version": "1.10",
  "render_controllers": {
    "controller.render.sonic_bow": {
      "arrays": {
        "textures": {
          "array.sonic_bow_texture_frames": [
            "texture.default",
            "texture.bow_pulling_0",
            "texture.bow_pulling_1",
            "texture.bow_pulling_2"
          ]
        },
        "geometries": {
          "array.sonic_bow_geo_frames": [
            "geometry.default",
            "geometry.bow_pulling_0",
            "geometry.bow_pulling_1",
            "geometry.bow_pulling_2"
          ]
        }
      },
      "geometry": "array.sonic_bow_geo_frames[math.clamp(math.floor(variable.charge_amount * 4.0), 0.0, 3.0)]",
      "materials": [{ "*": "material.default" }],
      "textures": ["array.sonic_bow_texture_frames[math.clamp(math.floor(variable.charge_amount * 4.0), 0.0, 3.0)]"]
    }
  }
}
